# Database: local SQLite file by default; use a Turso URL + token in production.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Public URL used for share links and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plus (one-off upgrade per pool). Without a key, dev unlocks Plus for free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Affiliate gift links (Amazon PartnerNet tag, e.g. namer-21).
AMAZON_PARTNER_TAG=

# Optional AdSense unit shown on free pools. Without it, a Plus house ad shows.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
